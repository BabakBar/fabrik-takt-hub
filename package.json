{
  "name": "fabriktakt-website",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun vite build && bun run scripts/generate-static-pages.ts",
    "build:dev": "bunx --bun vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "bun run lint && bun run typecheck && bun run build && bun run test:e2e",
    "preview": "bunx --bun vite preview"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "lucide-react": "^1.77.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "overrides": {
    "brace-expansion": "5.0.13",
    "flatted": "3.4.3",
    "js-yaml": "4.3.2",
    "zod": "4.6.7"
  }
}
